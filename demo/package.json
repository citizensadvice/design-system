{
  "name": "demo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test": "npm run playwright",
    "playwright": "npx playwright test",
    "playwright:update": "npx playwright test --update-snapshots",
    "playwright:ui": "npx playwright test --ui",
    "start-playwright-server": "./bin/start-playwright-server",
    "start-test-server": "RAILS_ENV=test ./bin/rails assets:precompile && ./bin/rails server -e test",
    "build:css": "sass ./app/assets/stylesheets/:./app/assets/builds --silence-deprecation=import --quiet-deps --no-source-map --load-path=node_modules",
    "build": "esbuild app/assets/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets"
  },
  "dependencies": {
    "@citizensadvice/design-system": "file:../",
    "esbuild": "^0.28.2",
    "sass": "^1.103.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1"
  }
}
